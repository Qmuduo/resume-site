{
  "code": "modern",
  "name": "现代简洁",
  "description": "左侧个人信息栏加右侧经历时间线，适合技术类岗位。",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "email": { "type": "string" },
      "phone": { "type": "string" },
      "summary": { "type": "string" },
      "experiences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "company": { "type": "string" },
            "title": { "type": "string" },
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        }
      }
    },
    "required": ["name"]
  },
  "html": "<div class=\"resume-modern\"><aside><h1>{{name}}</h1><p>{{email}}</p><p>{{phone}}</p></aside><section><h2>个人简介</h2><p>{{summary}}</p><h2>工作经历</h2>{{#each experiences}}<div class=\"exp\"><h3>{{company}}</h3><span>{{start}} - {{end}}</span><p>{{title}}</p></div>{{/each}}</section></div>",
  "css": ".resume-modern{display:flex;gap:24px}.resume-modern aside{width:220px;background:#f5f7fa;padding:16px}.resume-modern .exp{margin-bottom:8px}"
}
