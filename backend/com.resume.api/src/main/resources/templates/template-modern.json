{
  "code": "modern",
  "name": "现代简洁",
  "description": "左侧个人信息栏加右侧经历时间线，适合技术类岗位。",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "email": { "type": "string" },
      "phone": { "type": "string" },
      "summary": { "type": "string" },
      "experiences": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "company": { "type": "string" },
            "title": { "type": "string" },
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        }
      }
    },
    "required": ["name"]
  },
  "html": "<div class=\"resume-modern\"><aside>{{name}}<br/>{{email}}</aside><section>{{summary}}</section></div>",
  "css": ".resume-modern{display:flex;gap:24px}.resume-modern aside{width:220px}"
}
