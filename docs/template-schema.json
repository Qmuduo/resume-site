{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-site.local/schemas/template.schema.json",
  "title": "ResumeTemplate",
  "description": "简历模板对象受控 schema：AI 生成 template 只允许输出以下白名单字段。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "schema": {
      "type": "object",
      "description": "该模板接受的简历数据 JSON Schema"
    },
    "html": {
      "type": "string"
    },
    "css": {
      "type": "string"
    }
  },
  "required": ["code", "name", "html", "css"]
}
